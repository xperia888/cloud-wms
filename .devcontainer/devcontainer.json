{
  "name": "Cloud WMS",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "WMS API", "onAutoForward": "notify" }
  },

  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq postgresql-client >/dev/null && mvn -q -B -DskipTests dependency:go-offline",
  "postAttachCommand": "echo '启动系统（含测试数据与承运商模拟器）：mvn spring-boot:run -Dspring-boot.run.profiles=dev   然后打开 api-examples.http 逐个点击 Send Request'",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "humao.rest-client",
        "ckolkman.vscode-postgres"
      ]
    }
  }
}
